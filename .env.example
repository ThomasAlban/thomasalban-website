# Local development. uv loads this via --env-file; Django does not load it itself.
# Boolean settings accept true or false (case-insensitive), not 1/0.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-replace-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SITE_URL=http://localhost:8000

# Production (including collectstatic builds):
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<random secret: >=50 characters, >=5 distinct characters>
# Generate a unique secret; no django-insecure- prefix or replacement placeholders.
# DJANGO_ALLOWED_HOSTS=thomasalban.com,www.thomasalban.com,your-service.onrender.com
# Exact comma-separated hosts only: no *, leading dots, schemes, ports or paths.
# DJANGO_SITE_URL=https://thomasalban.com
# SITE_URL is an HTTP(S) origin only (optional trailing slash), with no credentials,
# path, query or fragment. Production requires HTTPS except for loopback/localhost.
# CSRF origins use the same origin syntax. Same-origin requests need no entry;
# add only genuinely trusted cross-origin form origins, not arbitrary domains.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.thomasalban.com

# Render Docker nginx overwrites the scheme with HTTPS; Render's public edge
# redirects HTTP to HTTPS. Gunicorn is loopback-only. See docs/deployment.md.
# Do not expose the container through an untrusted/plaintext public ingress.
DJANGO_TRUST_PROXY_HEADERS=false
# Production Render: DJANGO_TRUST_PROXY_HEADERS=true
# HSTS starts disabled. After verifying HTTPS, try 300 seconds before increasing.
# Include-subdomains and preload are separate, explicit commitments; leave off.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Production requires explicit absolute paths on the paid instance's mounted disk.
# Set these for builds too; settings/collectstatic do not access or create them.
# Provision the media directory and run migrations at runtime, not during builds.
# DJANGO_DATABASE_PATH=/var/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/data/media
# One instance only for SQLite; arrange persistent-disk/database/upload backups.
# STATIC_ROOT remains the build-local staticfiles directory, not the disk.

# Render Docker startup requires a separate nginx Basic-auth admin gate.
# Not needed by local runserver, builds, or Django tests. Set as Render secrets:
# ADMIN_GATE_USERNAME=<1-64 letters/digits/dot/underscore/hyphen>
# ADMIN_GATE_PASSWORD=<unique random 24-128 printable ASCII characters, no spaces>
# Gate credentials are separate from Django admin credentials. Never commit them.
# nginx shared rate budgets are in deploy/nginx.conf, not per-visitor IP limits.

# Enquiries stay disabled until both addresses are configured.
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_ENQUIRY_EMAIL=
# Console backend is local-only and does not deliver email. Builds may use it.
# Production delivery requires an authenticated sender and a real backend.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
# SMTP only: port must be 1-65535; TLS and SSL cannot both be true.
# For implicit TLS on port 465 set USE_TLS=false and USE_SSL=true.
# Credentials/addresses are not required at settings import or collectstatic time.
# Non-SMTP backends ignore all SMTP-specific options.
